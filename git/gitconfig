[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	ff = only
	autostash = true
[diff]
	algorithm = histogram
[fetch]
	prune = true
[rebase]
	autoStash = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
